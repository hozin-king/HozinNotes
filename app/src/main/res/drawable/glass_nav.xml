<?xml version="1.0" encoding="utf-8"?>
<!-- Bar kaca mengambang (bottom nav / toolbar): fill kaca + garis atas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
