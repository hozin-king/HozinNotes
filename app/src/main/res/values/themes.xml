<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HozinNotes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="colorSurface">@color/surface_light</item>
    </style>

    <!-- Glossy variant: same palette, glassy surfaces via drawables -->
    <style name="Theme.HozinNotes.Glossy" parent="Theme.HozinNotes">
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <style name="Theme.HozinNotes.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/brand_primary</item>
    </style>
</resources>
