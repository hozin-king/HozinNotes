<?xml version="1.0" encoding="utf-8"?>
<!-- v1.22: layar statistik pemakaian catatan -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/usage_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/usage_section_summary"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_archived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_trashed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/usage_section_activity"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_topday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/usage_section_content"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_chars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_avgchars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_longest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/usage_section_types"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_locked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/item_stat_row"
            android:id="@+id/stats_row_next_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/usage_section_folders"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/stats_folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/usage_section_memories"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/stats_memories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
