<?xml version="1.0" encoding="utf-8"?>
<!-- Override malam: glassmorphism gelap ala referensi. -->
<resources>
    <style name="Theme.HozinNotes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@drawable/bg_glass_gradient</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="materialCardViewStyle">@style/GlassCardView</item>
        <item name="bottomNavigationStyle">@style/GlassBottomNav</item>
    </style>

    <style name="Theme.HozinNotes.Glossy" parent="Theme.HozinNotes">
        <item name="android:windowBackground">@drawable/bg_glass_gradient</item>
    </style>

    <style name="Theme.HozinNotes.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/brand_primary</item>
    </style>

    <!-- Kartu kaca default: fill 25% putih, stroke 1dp, tanpa elevasi. -->
    <style name="GlassCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Bottom nav kaca mengambang. -->
    <style name="GlassBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/glass_nav</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
